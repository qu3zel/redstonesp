# Auto detect text files and perform LF normalization
* text=auto

# Ensure Windows batch files always use CRLF
*.bat text eol=crlf

# Binary files
*.ico binary
*.exe binary
*.o binary
*.res binary

# GitHub Linguist Language Configuration
*.cpp linguist-language=C++
*.rc linguist-vendored=true
build.bat linguist-vendored=true


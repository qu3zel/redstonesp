# Auto detect text files and perform LF normalization
* text=auto

# Ensure Windows batch files always use CRLF
*.bat text eol=crlf

# Binary files
*.ico binary
*.exe binary
*.o binary
*.res binary

# GitHub Linguist (Language Statistics)
*.cpp linguist-language=C++ linguist-detectable=true
*.rc linguist-detectable=false
build.bat linguist-detectable=false

